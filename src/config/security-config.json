{
  "security": {
    "encryption": {
      "algorithm": "AES-256-CBC",
      "keyLength": 32,
      "ivLength": 16
    },
    "signature": {
      "algorithm": "HMAC-SHA256",
      "keyLength": 32
    },
    "jwt": {
      "algorithm": "HS256",
      "expirationBuffer": 30
    },
    "request": {
      "maxAge": 300,
      "nonceLength": 32,
      "retryAttempts": 3
    },
    "endpoints": {
      "sensitive": [
        "/login",
        "/auth/",
        "/admin/",
        "/users/",
        "/permissions/",
        "/onboard-user",
        "/user-action",
        "/system-settings"
      ]
    }
  },
  "rateLimit": {
    "maxRequests": 100,
    "windowMs": 60000,
    "skipSuccessfulRequests": false
  },
  "cors": {
    "allowedOrigins": ["http://localhost:5173", "http://127.0.0.1:8000"],
    "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Timestamp",
      "X-Nonce",
      "X-Signature",
      "X-Encrypted",
      "X-Client-Version",
      "X-Client-Type"
    ]
  }
}